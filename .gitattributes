# Normaliza fim de linha para LF no repositorio.
#
# Sem isto, editar um arquivo no Windows reescreve a linha inteira com CRLF e o
# diff mostra o arquivo todo como alterado — foi o que aconteceu com as 8
# migrations de RPC, que apareciam com centenas de linhas mudadas sem nenhuma
# mudanca real de conteudo.
#
# Depois de adicionar este arquivo, rode uma vez:
#   git add --renormalize .

* text=auto eol=lf

# Binarios — nunca converter
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.pdf    binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.jar    binary
*.keystore binary
*.apk    binary
*.aab    binary

# Scripts que exigem fim de linha especifico
*.bat    text eol=crlf
gradlew  text eol=lf
